{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",

		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,

		/* Relaxed on purpose.
		 *
		 * This code was ported from ~4,300 lines of untyped JavaScript that
		 * lived inside template literals and was never checked by anything.
		 * Even at this setting the compiler catches what actually broke in
		 * production: undefined variables, misspelled identifiers, wrong
		 * argument counts, and bad imports. Annotating every prop up front
		 * would have turned a mechanical port into a rewrite, which is much
		 * harder to review for behaviour changes.
		 *
		 * Tighten incrementally: turn on noImplicitAny first, then strict.
		 */
		"strict": false,
		"noImplicitAny": false,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,

		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
